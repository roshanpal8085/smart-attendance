# ════════════════════════════════════════════════════════════════
# Smart Attendance — .gitignore
# ════════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.so
*.pdb
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Node / Next.js ───────────────────────────────────────────────
node_modules/
.next/
.cache/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn/

# ── React Native ─────────────────────────────────────────────────
android/app/build/
android/.gradle/
android/local.properties
ios/build/
ios/Pods/
ios/DerivedData/
*.xcworkspace/
*.xcuserstate
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ── Docker ───────────────────────────────────────────────────────
# Keep .env.example, ignore actual .env files
.env
.env.local
.env.*.local
!.env.example
!apps/**/.env.example

# ── IDE / Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log

# ── Alembic (keep versions folder, ignore generated) ─────────────
backend/alembic/versions/*.pyc
