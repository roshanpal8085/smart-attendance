# ════════════════════════════════════════════════════════════════
# Smart Attendance — Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit the .env file to version control.
# ════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_NAME=Smart Attendance API
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=attendance_db
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+psycopg://attendance_user:change_me_in_production@postgres:5432/attendance_db

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-THIS-TO-A-256-BIT-RANDOM-SECRET
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
JWT_ALGORITHM=HS256

# ── Attendance Rules ─────────────────────────────────────────────
ATTENDANCE_SESSION_DURATION_SECONDS=120
PRESENCE_WINDOW_REQUIRED_SECONDS=900
BLE_RSSI_THRESHOLD=-80

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Admin Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
